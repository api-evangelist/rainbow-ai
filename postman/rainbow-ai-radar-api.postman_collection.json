              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/weather/radar?lat=<float>&lon=<float>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "weather",
                    "radar"
                  ],
                  "query": [
