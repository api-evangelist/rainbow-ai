                          "name": "Get Weather Map Tile",
                          "id": "8352d1bf-4e8d-4e8c-8d0d-89a91579cc64",
                          "protocolProfileBehavior": {
                            "disableBodyPruning": true
                          },
                          "request": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "image/png"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/map/tile/:z/:x/:y?timestamp=<dateTime>&layer=precipitation",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                "map",
                                "tile",
                                ":z",
                                ":x",
                                ":y"
                              ],
                              "query": [
                                {
                                  "description": "ISO 8601 timestamp for the desired forecast time. If omitted, returns the current precipitation tile.",
                                  "key": "timestamp",
                                  "value": "<dateTime>"
                                },
                                {
                                  "description": "The weather layer type to render",
                                  "key": "layer",
                                  "value": "precipitation"
                                }
                              ],
                              "variable": [
                                {
                                  "id": "adc03c61-f508-4ce8-b075-1574211ebbd9",
                                  "key": "z",
                                  "value": "<integer>",
                                  "description": "(Required) Zoom level (0-18)"
                                },
                                {
                                  "id": "3e23aa37-e6b8-4c3b-92e1-4522c18d5b39",
                                  "key": "x",
                                  "value": "<integer>",
                                  "description": "(Required) Tile X coordinate"
                                },
                                {
                                  "id": "17d39619-fe71-42a2-8d88-0f5773655da5",
                                  "key": "y",
                                  "value": "<integer>",
                                  "description": "(Required) Tile Y coordinate"
                                }
                              ]
                            },
                            "description": "Returns a 256x256 PNG weather map tile at the specified zoom level and tile coordinates using the XYZ tiling scheme. Tiles show precipitation forecasts and can be overlaid on any mapping library (Leaflet, Mapbox, Google Maps, etc.)."
                          },
