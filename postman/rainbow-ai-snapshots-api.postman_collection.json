          "item": [
            {
              "name": "Get Map Snapshot",
              "id": "a9291a08-94fd-4399-962c-41b9a187267b",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "image/png"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/map/snapshot?bbox=<string>&width=256&height=256&timestamp=<dateTime>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "map",
                    "snapshot"
                  ],
                  "query": [
                    {
                      "description": "(Required) Bounding box as comma-separated values: minLon,minLat,maxLon,maxLat",
                      "key": "bbox",
                      "value": "<string>"
                    },
                    {
                      "description": "Output image width in pixels",
                      "key": "width",
                      "value": "256"
                    },
                    {
                      "description": "Output image height in pixels",
                      "key": "height",
                      "value": "256"
                    },
                    {
                      "description": "ISO 8601 timestamp for the desired forecast time",
                      "key": "timestamp",
                      "value": "<dateTime>"
                    }
                  ]
                },
                "description": "Returns a static precipitation map image for a given bounding box, useful for generating weather map previews or thumbnails without a full mapping library integration."
              },
