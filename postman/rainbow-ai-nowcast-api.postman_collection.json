                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/weather/nowcast?lat=<float>&lon=<float>&timezone=<string>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "weather",
                    "nowcast"
                  ],
                  "query": [
