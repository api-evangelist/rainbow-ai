              "path": [
                "weather",
                "nowcast"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<float>",
                  "description": "(Required) Latitude of the location (-90 to 90)"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<float>",
                  "description": "(Required) Longitude of the location (-180 to 180)"
                },
                {
                  "disabled": false,
                  "key": "timezone",
                  "value": "<string>",
                  "description": "IANA timezone identifier for timestamp formatting (e.g., America/New_York)"
