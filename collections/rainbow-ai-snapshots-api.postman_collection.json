        {
          "id": "5f62d510-368f-42b2-8ce1-45d7a2a7aa3d",
          "name": "Get Map Snapshot",
          "request": {
            "name": "Get Map Snapshot",
            "description": {
              "content": "Returns a static precipitation map image for a given bounding box, useful for generating weather map previews or thumbnails without a full mapping library integration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "map",
                "snapshot"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bbox",
                  "value": "<string>",
                  "description": "(Required) Bounding box as comma-separated values: minLon,minLat,maxLon,maxLat"
                },
                {
                  "disabled": false,
                  "key": "width",
                  "value": "256",
                  "description": "Output image width in pixels"
                },
                {
                  "disabled": false,
                  "key": "height",
                  "value": "256",
                  "description": "Output image height in pixels"
                },
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp for the desired forecast time"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
