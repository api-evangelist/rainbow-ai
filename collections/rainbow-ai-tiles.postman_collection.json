          "name": "Get Map Snapshot",
          "request": {
            "name": "Get Map Snapshot",
            "description": {
              "content": "Returns a static precipitation map image for a given bounding box, useful for generating weather map previews or thumbnails without a full mapping library integration.",
              "type": "text/plain"
            },
