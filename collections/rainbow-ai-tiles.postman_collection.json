    {
      "id": "86b56a6f-80a7-4442-b8e4-81b150e33103",
      "name": "Tiles",
      "description": {
        "content": "Weather map tile retrieval operations",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "70fb8fe9-ac7c-428b-bf05-c21feffad054",
          "name": "Get Weather Map Tile",
          "request": {
            "name": "Get Weather Map Tile",
            "description": {
              "content": "Returns a 256x256 PNG weather map tile at the specified zoom level and tile coordinates using the XYZ tiling scheme. Tiles show precipitation forecasts and can be overlaid on any mapping library (Leaflet, Mapbox, Google Maps, etc.).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "map",
                "tile",
                ":z",
                ":x",
                ":y"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "timestamp",
                  "value": "<dateTime>",
                  "description": "ISO 8601 timestamp for the desired forecast time. If omitted, returns the current precipitation tile."
                },
                {
                  "disabled": false,
                  "key": "layer",
                  "value": "precipitation",
                  "description": "The weather layer type to render"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "z",
                  "description": "(Required) Zoom level (0-18)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "x",
                  "description": "(Required) Tile X coordinate"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "y",
                  "description": "(Required) Tile Y coordinate"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "823ab058-b5d7-483f-b904-71f5330001a0",
              "name": "PNG weather map tile image",
